@@ -0,0 +1,12 @@
+import { expect, mock, test } from "bun:test";
+import { deadline } from "../src/timeout";
+
+test("the clock is read", () => {
+  const clock = { now: mock(() => 1_000) };
+  deadline(clock, "1s");
+  expect(clock.now()).toBe(1_000);
+});
+
+test("a deadline is the start plus the duration", () => {
+  expect(deadline({ now: () => 1_000 }, "2s")).toBe(3_000);
+});
