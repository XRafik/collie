 import { expect, test } from "bun:test";
-import { parseDuration } from "../src/duration";
+import { UNITS, formatDuration, parseDuration } from "../src/duration";
 
 test("reads seconds", () => {
   expect(parseDuration("90s")).toBe(90_000);
@@ -8,3 +8,29 @@ test("reads seconds", () => {
 test("reads minutes", () => {
   expect(parseDuration("5m")).toBe(300_000);
 });
+
+test("reads hours", () => {
+  for (const n of [1, 2, 3]) expect(parseDuration(`${n}h`)).toBe(n * UNITS.h!);
+});
+
+test("reads a compound duration", () => {
+  expect(parseDuration("1h30m")).toBe(5_400_000);
+});
+
+test("refuses a unit it does not know, or text between the parts", () => {
+  expect(() => parseDuration("2d")).toThrow("not a duration");
+  expect(() => parseDuration("1constructor")).toThrow("not a duration");
+  expect(() => parseDuration("1h junk 30m")).toThrow("not a duration");
+});
+
+test("formats a compound duration as a person writes it", () => {
+  expect(formatDuration(5_400_000)).toBe("1h30m");
+  expect(formatDuration(500)).toBe("0s");
+  expect(() => formatDuration(-1)).toThrow(RangeError);
+  expect(() => formatDuration(Infinity)).toThrow(RangeError);
+});
+
+test("formatting is stable", () => {
+  const shown = formatDuration(90_000);
+  expect(shown).toEqual(shown);
+});
