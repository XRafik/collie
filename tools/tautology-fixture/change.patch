@@ -1,12 +1,35 @@
 export const UNITS: Record<string, number> = {
   s: 1000,
   m: 60 * 1000,
+  h: 60 * 60 * 1000,
 };
 
-/** Milliseconds in a duration written as a number and a unit, such as `90s` or `5m`. */
+/** Milliseconds in a duration such as `90s`, `5m` or `1h30m`. */
 export function parseDuration(text: string): number {
-  const match = /^(\d+)([a-z]+)$/.exec(text.trim().toLowerCase());
-  const unit = match ? UNITS[match[2]!] : undefined;
-  if (!match || unit === undefined) throw new Error(`not a duration: ${text}`);
-  return Number(match[1]) * unit;
+  const written = text.trim().toLowerCase();
+  const parts = [...written.matchAll(/(\d+)([a-z]+)/g)];
+  // Matched whole: matchAll alone skips what lies between parts, so `1h junk 30m` would read.
+  if (parts.length === 0 || parts.map((part) => part[0]).join("") !== written)
+    throw new Error(`not a duration: ${text}`);
+  let total = 0;
+  for (const [, amount, name] of parts) {
+    if (!Object.hasOwn(UNITS, name!)) throw new Error(`not a duration: ${text}`);
+    // Add the amount times the unit to the total.
+    total += Number(amount) * UNITS[name!]!;
+  }
+  return total;
+}
+
+/** A duration as a person writes it, largest unit first: `5400000` is `1h30m`. */
+export function formatDuration(ms: number): string {
+  if (!Number.isFinite(ms) || ms < 0) throw new RangeError(`not a duration: ${ms}`);
+  let left = ms;
+  let out = "";
+  for (const name of ["h", "m", "s"]) {
+    const unit = UNITS[name]!;
+    const amount = Math.floor(left / unit);
+    if (amount > 0) out += `${amount}${name}`;
+    left -= amount * unit;
+  }
+  return out || "0s";
 }
diff --git a/src/timeout.ts b/src/timeout.ts
new file mode 100644
index 0000000..f482e71
--- /dev/null
+++ b/src/timeout.ts
@@ -0,0 +1,10 @@
+import { parseDuration } from "./duration";
+
+export interface Clock {
+  now(): number;
+}
+
+/** When work that starts now and is given `text` to run must be done by. */
+export function deadline(clock: Clock, text: string): number {
+  return clock.now() + parseDuration(text);
+}
