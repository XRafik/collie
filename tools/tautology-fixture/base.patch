+export const UNITS: Record<string, number> = {
+  s: 1000,
+  m: 60 * 1000,
+};
+
+/** Milliseconds in a duration written as a number and a unit, such as `90s` or `5m`. */
+export function parseDuration(text: string): number {
+  const match = /^(\d+)([a-z]+)$/.exec(text.trim().toLowerCase());
+  const unit = match ? UNITS[match[2]!] : undefined;
+  if (!match || unit === undefined) throw new Error(`not a duration: ${text}`);
+  return Number(match[1]) * unit;
+}
