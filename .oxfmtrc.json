{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "ignorePatterns": [
    ".agent/**",
    ".agents/**",
    ".claude/**",
    ".codex/**",
    ".continue/**",
    ".cursor/**",
    ".gemini/**",
    ".opencode/**",
    ".pi/**",
    ".roo/**",
    ".scratch/**",
    ".windsurf/**",
    "advisor-plans/**",
    "plans/**",
    // Exported brand assets stay byte-identical to the kit and its checksum manifest.
    "assets/brand/**",
    // Vendored byte for byte from upstream; `.collie/skills/pin.json` hashes them.
    ".collie/skills/*/**",
    ".collie/skills/LICENSE",
    // herdr prints this; `bun run contract:regen` writes it verbatim and CI diffs it.
    "herdr-api-schema.json",
    "tools/oxlint/anti-slop/**"
  ]
}
